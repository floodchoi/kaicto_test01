{
  "functions": {
    "api/misc.js": { "includeFiles": "migrate.sql" }
  },
  "rewrites": [
    { "source": "/api/users", "destination": "/api/misc?fn=users" },
    { "source": "/api/log", "destination": "/api/misc?fn=log" },
    { "source": "/api/usage", "destination": "/api/misc?fn=usage" },
    { "source": "/api/integrations", "destination": "/api/misc?fn=integrations" },
    { "source": "/api/invite-codes", "destination": "/api/misc?fn=invite-codes" },
    { "source": "/api/migrate", "destination": "/api/misc?fn=migrate" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
